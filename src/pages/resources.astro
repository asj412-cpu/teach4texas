---
import BaseLayout from '../layouts/BaseLayout.astro';
import TptProductCard from '../components/TptProductCard.astro';
import { TPT_STORE_URL } from '../lib/site-links';
import { SCORE_DESK_APP, TPT_LISTINGS, listingsByCategory } from '../lib/tpt-catalog';

const freeListings = listingsByCategory('free');
const scoreDeskPacks = listingsByCategory('score-desk');
const vaults = listingsByCategory('vault');
const PHONICS_IDS = new Set(['18290327', '18290364']);
const phonics = TPT_LISTINGS.filter((item) => PHONICS_IDS.has(item.id));
const classroom = listingsByCategory('classroom').filter((item) => !PHONICS_IDS.has(item.id));

const SITE = 'https://www.teach4texas.com';
const PAGE_URL = `${SITE}/resources`;
const phonicsCards = phonics.map((l) => {
  if (!l.image) throw new Error(`Phonics card ${l.id} is missing a catalog cover`);
  const image = `${SITE}${l.image}`;
  const pinHref =
    'https://www.pinterest.com/pin/create/button/?' +
    new URLSearchParams({
      url: `${PAGE_URL}#phonics-partner-games`,
      media: image,
      description: `${l.title} | Long-vowel-team partner games from Teach4 Texas`,
    }).toString();
  return { listing: l, imagePath: l.image, pinHref };
});
---

<BaseLayout
  title="Texas Teacher Resources: STAAR, TIA & Classroom"
  description="Live STAAR prep, TIA, and classroom resources from the Teach4 Texas Teachers Pay Teachers store. Score Desk printables, Number Vault, Archive Vault, Cycle Vault, and more."
>
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#14244B] mb-4">Resources</h1>
    <p class="text-xl text-gray-600 mb-6">
      Templates, trackers, and tools built by Texas educators, for Texas educators. Every paid card below goes to a live product page on Teachers Pay Teachers.
    </p>
    <p class="mb-6">
      <a href="/staar/seasonal-math" class="text-[#B95321] font-semibold underline">Seasonal STAAR Math: Back to School through Christmas, Grades 3–4 &rarr;</a>
      <br />
      <a href="/staar/math-escape-rooms" class="text-[#B95321] font-semibold underline">STAAR Math Escape Rooms, Grades 3–5 &rarr;</a>
      <br />
      <a href="/teks/morning-work" class="text-[#B95321] font-semibold underline">TEKS Morning Work, Grades 3–4 &rarr;</a>
      <br />
      <a href="#phonics-partner-games" class="text-[#B95321] font-semibold underline">Phonics partner games, Grades 1–2 &rarr;</a>
    </p>
    <p class="mb-12">
      <a
        href={TPT_STORE_URL}
        target="_blank"
        rel="noopener"
        class="inline-block btn-primary"
      >
        Browse the Teach4 Texas TPT store &rarr;
      </a>
    </p>

    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-2">Free Resources</h2>
      <p class="text-gray-600 mb-6">Start here — no cost, no catch.</p>
      <div class="grid md:grid-cols-2 gap-6 items-start">
        <a href={SCORE_DESK_APP.href} class="block border-2 border-rq-gold bg-white rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-3">
            <span class="inline-block bg-rq-gold text-rq-navy text-base font-bold px-2 py-1 rounded">FREE</span>
          </div>
          <h3 class="text-xl font-bold text-[#14244B] mb-2">{SCORE_DESK_APP.title}</h3>
          <p class="text-gray-600 mb-3">{SCORE_DESK_APP.description}</p>
          <span class="text-[#B95321] font-semibold text-base">{SCORE_DESK_APP.cta} &rarr;</span>
        </a>
        {freeListings.map((item) => (
          <TptProductCard
            href={item.href}
            title={item.title}
            description={item.description}
            price={item.price}
            originalPrice={item.originalPrice}
            image={item.image}
            highlight
          />
        ))}
      </div>
    </div>

    <div id="products" class="mb-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-2">Score Desk printables</h2>
      <p class="text-gray-600 mb-6">Rubrics, checklists, and TIA evidence pages that pair with the free Score Desk app.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {scoreDeskPacks.map((item) => (
          <TptProductCard
            href={item.href}
            title={item.title}
            description={item.description}
            price={item.price}
            originalPrice={item.originalPrice}
            image={item.image}
          />
        ))}
      </div>
    </div>

    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-2">STAAR Vault escape rooms</h2>
      <p class="text-gray-600 mb-6">Self-checking Google Slides rooms, most at the current $4.99 listing price (Labor Day Grade 3 is $3.99). Hispanic Heritage Month Grade 3 scavenger hunt, Crack the Code Grade 3 math mystery, Labor Day Grade 3, First Day Grade 4 scavenger hunt, Back to School Grade 3, Number Vault G7, Archive Vault, and Cycle Vault are on this grid.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {vaults.map((item) => (
          <TptProductCard
            href={item.href}
            title={item.title}
            description={item.description}
            price={item.price}
            originalPrice={item.originalPrice}
            image={item.image}
          />
        ))}
      </div>
    </div>

    <div id="phonics-partner-games" class="mb-16" style="scroll-margin-top: 6rem">
      <h2 class="text-2xl font-bold text-[#14244B] mb-2">Phonics partner games, Grades 1–2</h2>
      <p class="text-gray-600 mb-6">Print-and-play partner games for long-vowel teams. Grade 1 and Grade 2 editions; no prep beyond printing. There is no live play demo on these listings.</p>
      <div class="grid md:grid-cols-2 gap-6">
        {phonicsCards.map((c) => (
          <article class="border border-gray-200 rounded-lg overflow-hidden flex flex-col">
            <a href={c.listing.href} target="_blank" rel="noopener">
              <img src={c.imagePath} alt={`TPT cover preview: ${c.listing.title}`} width="800" height="1000" loading="lazy" class="w-full h-auto" />
            </a>
            <div class="p-5 flex flex-col gap-3 flex-1">
              <h3 class="text-lg font-bold text-[#14244B]">{c.listing.title}</h3>
              <p class="text-gray-600 text-base">{c.listing.description}</p>
              <div class="mt-auto flex flex-wrap gap-3 text-base font-semibold">
                <a href={c.listing.href} target="_blank" rel="noopener" class="text-[#B95321]">{c.listing.price} on TPT &rarr;</a>
                <a href={c.pinHref} target="_blank" rel="noopener" data-pin-do="buttonPin" class="text-[#B8001C]">Pin It</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-2">More from the TPT store</h2>
      <p class="text-gray-600 mb-6">Grade 3 TEKS morning work (Print), lesson plans, grammar rooms, TIA kits, and seasonal resources currently listed on the Spring Teach4 Texas store.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {classroom.map((item) => (
          <TptProductCard
            href={item.href}
            title={item.title}
            description={item.description}
            price={item.price}
            originalPrice={item.originalPrice}
            image={item.image}
          />
        ))}
      </div>
    </div>

    <div class="bg-white rounded-lg p-8 text-center">
      <h2 class="text-2xl font-bold text-[#14244B] mb-4">Get Free Resources &amp; Updates</h2>
      <p class="text-gray-600 mb-6">Join our email list for free STAAR prep materials, TIA tips, and first access to new resources.</p>
      <form action="https://app.convertkit.com/forms/9114260/subscriptions" method="post" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input type="email" name="email_address" placeholder="Enter your email" required class="flex-1 px-4 py-3 rounded-lg border border-gray-300" />
        <button type="submit" class="btn-secondary">Subscribe</button>
      </form>
    </div>
  </div>
</BaseLayout>
