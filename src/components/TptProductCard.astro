---
interface Props {
  href: string;
  title: string;
  description: string;
  price: string;
  originalPrice?: string;
  cta?: string;
  highlight?: boolean;
}

const { href, title, description, price, originalPrice, cta, highlight = false } = Astro.props;
const isFree = price === 'FREE';
const onSale = Boolean(originalPrice && originalPrice !== price);
const priceLabel = cta ?? (isFree ? 'Free on TPT' : `${price} on TPT`);
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[
    'block rounded-lg p-6 hover:shadow-md transition-shadow',
    highlight ? 'border-2 border-green-200 bg-green-50' : 'border border-gray-200',
  ]}
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <h3 class="text-lg font-bold text-[#1B365D]">{title}</h3>
    {isFree && (
      <span class="shrink-0 inline-block bg-green-600 text-white text-xs font-bold px-2 py-1 rounded">FREE</span>
    )}
  </div>
  <p class="text-gray-600 text-sm mb-3">{description}</p>
  <span class="text-[#BF5700] font-semibold text-sm">
    {onSale ? (
      <>
        <span class="text-gray-400 line-through mr-2">{originalPrice}</span>
        {price} on TPT &rarr;
      </>
    ) : (
      <>{priceLabel} &rarr;</>
    )}
  </span>
</a>
