---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resources — Teach4Texas" description="STAAR prep resources, TIA guides, and classroom tools for Texas teachers. Available on TPT and Gumroad.">
  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#1B365D] mb-4">Resources</h1>
    <p class="text-xl text-gray-600 mb-12">Templates, trackers, and tools built by Texas educators, for Texas educators.</p>

    <!-- FREE Resources -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#1B365D] mb-2">Free Resources</h2>
      <p class="text-gray-500 mb-6">Start here — no cost, no catch.</p>
      <div class="grid md:grid-cols-2 gap-6">
        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border-2 border-green-200 bg-green-50 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">🌟</span>
            <span class="inline-block bg-green-600 text-white text-xs font-bold px-2 py-1 rounded">FREE</span>
          </div>
          <h3 class="text-xl font-bold text-[#1B365D] mb-2">TIA Quick Reference Card</h3>
          <p class="text-gray-600 mb-3">Everything you need to know about TIA designation levels, pay increases, and next steps — on one printable page.</p>
          <span class="text-[#BF5700] font-semibold text-sm">Download on TPT &rarr;</span>
        </a>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-3xl">📈</span>
            <span class="inline-block bg-yellow-100 text-yellow-800 text-xs font-bold px-2 py-1 rounded">COMING SOON</span>
          </div>
          <h3 class="text-xl font-bold text-[#1B365D] mb-2">Student Growth Tracker</h3>
          <p class="text-gray-600">Google Sheets template to track individual student growth across assessments. Auto-calculates growth and generates charts for TIA documentation.</p>
        </div>
      </div>
    </div>

    <!-- TPT Products -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#1B365D] mb-2">On Teachers Pay Teachers</h2>
      <p class="text-gray-500 mb-6">Classroom-tested resources for STAAR prep and TIA.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">📋</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">TIA Portfolio Guide & Evidence Kit</h3>
          <p class="text-gray-600 text-sm mb-3">Complete portfolio organization system with evidence collection checklists and month-by-month calendar.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$8.99 on TPT &rarr;</span>
        </a>

        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">✅</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">T-TESS Observation Prep Kit</h3>
          <p class="text-gray-600 text-sm mb-3">Domain-by-domain checklists and templates to help you score Distinguished on your next evaluation.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$6.99 on TPT &rarr;</span>
        </a>

        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">🔢</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">STAAR Math Lesson Plans (3-5)</h3>
          <p class="text-gray-600 text-sm mb-3">5 complete hands-on math lessons with STAAR 2.0 format practice for grades 3, 4, and 5.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$9.99 on TPT &rarr;</span>
        </a>

        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">📖</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">STAAR RLA Lesson Plans (3-5)</h3>
          <p class="text-gray-600 text-sm mb-3">Constructed response + reading comprehension lessons aligned to STAAR 2.0 for grades 3-5.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$9.99 on TPT &rarr;</span>
        </a>

        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">🔬</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">STAAR Science Lessons (5 & 8)</h3>
          <p class="text-gray-600 text-sm mb-3">Hands-on lab investigations and review activities for 5th and 8th grade science.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$9.99 on TPT &rarr;</span>
        </a>

        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="block border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl mb-3 block">🔓</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-2">Grammar Escape Rooms</h3>
          <p class="text-gray-600 text-sm mb-3">5 themed digital escape room activities for grammar review. Grades 3-5.</p>
          <span class="text-[#BF5700] font-semibold text-sm">$4.99-$19.99 on TPT &rarr;</span>
        </a>
      </div>
    </div>

    <!-- STAAR Boot Camp -->
    <div class="mb-16">
      <h2 class="text-2xl font-bold text-[#1B365D] mb-2">STAAR Boot Camp Packages</h2>
      <p class="text-gray-500 mb-6">Complete themed prep week packages — 5-day lesson plans, activities, decorations, student materials, and parent letters. Everything you need for an unforgettable STAAR review week.</p>

      <!-- Mega Bundle Highlight -->
      <div class="bg-gradient-to-br from-[#1B365D] to-[#2a4a7f] text-white rounded-xl p-8 mb-8">
        <div class="flex flex-col md:flex-row items-center gap-6">
          <div class="flex-1">
            <span class="inline-block bg-[#BF5700] text-white text-xs font-bold px-3 py-1 rounded-full mb-3">BEST VALUE — SAVE 55%</span>
            <h3 class="text-2xl font-bold mb-2">STAAR Boot Camp MEGA BUNDLE</h3>
            <p class="text-blue-200 mb-4">All 6 themed prep week packages in one download. That's 30 days of lesson plans, 66+ activities, and 6 complete decoration guides.</p>
            <div class="flex items-baseline gap-3 mb-4">
              <span class="text-3xl font-bold">$59</span>
              <span class="text-blue-300 line-through">$132</span>
            </div>
            <a href="YOUR_GUMROAD_URL" target="_blank" rel="noopener" class="inline-block bg-[#BF5700] hover:bg-[#a34900] text-white font-bold py-3 px-8 rounded-lg transition-colors">Get the Bundle</a>
          </div>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-2xl">🚀</span>
            <span class="inline-block bg-[#1B365D] text-white text-xs font-bold px-2 py-1 rounded">PREMIUM</span>
          </div>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">STAAR Wars</h3>
          <p class="text-gray-600 text-sm mb-3">Space/sci-fi themed prep week. Students become cadets on missions to STAAR mastery.</p>
          <span class="font-bold text-[#1B365D]">$29</span>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-2xl">🏆</span>
            <span class="inline-block bg-[#1B365D] text-white text-xs font-bold px-2 py-1 rounded">PREMIUM</span>
          </div>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">Championship Week</h3>
          <p class="text-gray-600 text-sm mb-3">Sports/tournament themed. Quarterfinals to championship with MVP awards.</p>
          <span class="font-bold text-[#1B365D]">$29</span>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <div class="flex items-center gap-2 mb-3">
            <span class="text-2xl">🌿</span>
            <span class="inline-block bg-[#1B365D] text-white text-xs font-bold px-2 py-1 rounded">PREMIUM</span>
          </div>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">STAAR-vival</h3>
          <p class="text-gray-600 text-sm mb-3">Survival/adventure themed. 5 terrains of review with Tribal Council games.</p>
          <span class="font-bold text-[#1B365D]">$29</span>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-2xl mb-3 block">💥</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">STAAR Power</h3>
          <p class="text-gray-600 text-sm mb-3">Superhero themed. Hero training sessions and villain battle reviews.</p>
          <span class="font-bold text-[#1B365D]">$15</span>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-2xl mb-3 block">🌮</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">Taco 'Bout STAAR Ready</h3>
          <p class="text-gray-600 text-sm mb-3">Fiesta/food themed with built-in differentiation: Mild, Medium, Spicy levels.</p>
          <span class="font-bold text-[#1B365D]">$15</span>
        </div>

        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-2xl mb-3 block">🔍</span>
          <h3 class="text-lg font-bold text-[#1B365D] mb-1">STAAR Trek</h3>
          <p class="text-gray-600 text-sm mb-3">Detective/mystery themed. A week-long case to solve through review activities.</p>
          <span class="font-bold text-[#1B365D]">$15</span>
        </div>
      </div>
    </div>

    <!-- Email Signup -->
    <div class="bg-gray-50 rounded-lg p-8 text-center">
      <h2 class="text-2xl font-bold text-[#1B365D] mb-4">Get Free Resources & Updates</h2>
      <p class="text-gray-600 mb-6">Join our email list for free STAAR prep materials, TIA tips, and first access to new resources.</p>
      <form action="https://app.convertkit.com/forms/YOUR_FORM_ID/subscriptions" method="post" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input type="email" name="email_address" placeholder="Enter your email" required class="flex-1 px-4 py-3 rounded-lg border border-gray-300" />
        <button type="submit" class="bg-[#BF5700] hover:bg-[#a34900] text-white font-bold py-3 px-6 rounded-lg transition-colors">Subscribe</button>
      </form>
    </div>
  </div>
</BaseLayout>
