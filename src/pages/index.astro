---
import BaseLayout from '../layouts/BaseLayout.astro';
import TptProductCard from '../components/TptProductCard.astro';
import { getCollection } from 'astro:content';
import { TPT_STORE_URL } from '../lib/site-links';
import { featuredListings } from '../lib/tpt-catalog';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
import { existsSync } from 'node:fs';
const featured = featuredListings();
// Real TPT cover images already on the site (never mockups); fall back to no image.
const coverFor = (item: { id: string; image?: string }) => {
  if (item.image) return item.image;
  for (const dir of ['seasonal', 'escape-rooms', 'morning-work']) {
    const rel = `/images/${dir}/tpt-${item.id}-cover.jpg`;
    if (existsSync(`public${rel}`)) return rel;
  }
  return undefined;
};
---

<BaseLayout title="STAAR Prep, TIA Guides & Teacher Tools for Texas">
  <section class="relative overflow-hidden bg-rq-navy text-rq-cream">
    <!-- Ranger Quest hero scene (rendered brand art, no UI). Mobile gets a smaller webp crop. -->
    <picture>
      <source media="(max-width: 767px)" srcset="/images/brand/hero-scene-mobile-640.webp" type="image/webp" />
      <source srcset="/images/brand/hero-scene-1440.webp" type="image/webp" />
      <img src="/images/brand/hero-scene-1440.jpg" alt="" width="1440" height="810" fetchpriority="high" decoding="async" class="absolute inset-0 w-full h-full object-cover object-right" />
    </picture>
    <div class="absolute inset-0 hero-scrim"></div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-28">
    <div class="max-w-2xl text-left">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-rq-cream hero-outline">Texas Teacher Tools That <span class="text-rq-gold">Actually Work</span></h1>
      <p class="text-xl md:text-2xl text-rq-gold mb-4">STAAR Prep → Student Growth → TIA Designation</p>
      <p class="text-lg text-rq-cream mb-8">Practical resources to boost your students' scores and earn up to $36,000/year through TIA.</p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/resources" class="btn-primary text-lg">Explore Resources</a>
        <a href={TPT_STORE_URL} target="_blank" rel="noopener" class="btn-secondary text-lg">Shop the TPT store</a>
      </div>
    </div>
    </div>
  </section>

  <section class="py-16 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center text-[#14244B] mb-12">What We Cover</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center p-6 rounded-lg border border-gray-200">
          <div class="text-4xl mb-4">📊</div>
          <h3 class="text-xl font-bold text-[#14244B] mb-3">STAAR Prep</h3>
          <p class="text-gray-600">Redesigned-format practice resources, strategies, and data-driven instruction guides for every tested subject.</p>
        </div>
        <div class="text-center p-6 rounded-lg border border-gray-200">
          <div class="text-4xl mb-4">🏆</div>
          <h3 class="text-xl font-bold text-[#14244B] mb-3">TIA Designation</h3>
          <p class="text-gray-600">Step-by-step guides to the TIA designation levels (Acknowledged, Recognized, Exemplary, and Master) and the evidence behind them.</p>
        </div>
        <div class="text-center p-6 rounded-lg border border-gray-200">
          <div class="text-4xl mb-4">🛠️</div>
          <h3 class="text-xl font-bold text-[#14244B] mb-3">Teacher Tools</h3>
          <p class="text-gray-600">Templates, trackers, and micro-tools that save you hours every week on the busywork.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="products" class="py-16 px-4 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl font-bold text-center text-[#14244B] mb-3">On Teachers Pay Teachers</h2>
      <p class="text-center text-gray-600 mb-10 max-w-2xl mx-auto">
        Live listings from the Teach4 Texas store. Each card opens that product — not the store root.
      </p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featured.map((item) => (
          <TptProductCard
            href={item.href}
            title={item.title}
            description={item.description}
            price={item.price}
            originalPrice={item.originalPrice}
            highlight={item.price === 'FREE'}
            image={coverFor(item)}
          />
        ))}
      </div>
      <p class="text-center mt-10">
        <a href="/resources#products" class="text-[#B95321] font-semibold hover:text-[#9E4519]">See all resources</a>
        <span class="text-gray-600 mx-2">·</span>
        <a href={TPT_STORE_URL} target="_blank" rel="noopener" class="text-[#B95321] font-semibold hover:text-[#9E4519]">Open the TPT store</a>
      </p>
    </div>
  </section>

  <section class="py-16 px-4 bg-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-center text-[#14244B] mb-12">Latest Posts</h2>
      <div class="space-y-8">
        {posts.map((post) => (
          <article class="bg-white rounded-lg shadow-sm p-6 hover:shadow-md transition-shadow">
            <a href={`/blog/${post.slug}`} class="block">
              <h3 class="text-xl font-bold text-[#14244B] hover:text-[#B95321] transition-colors mb-2">{post.data.title}</h3>
              <p class="text-gray-600 mb-3">{post.data.description}</p>
              <div class="flex gap-2 flex-wrap">
                {post.data.tags.map((tag: string) => (
                  <span class="text-base bg-[#FDEBC0] text-[#14244B] px-2 py-1 rounded">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="subscribe" class="py-16 px-4 bg-[#14244B] text-white">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Stay in the Loop</h2>
      <p class="text-rq-cream mb-6">Get STAAR prep tips, TIA strategies, and free resources delivered to your inbox.</p>
      <p class="text-rq-gold text-base mb-8">Unsubscribe anytime.</p>
      <form action="https://app.convertkit.com/forms/9114260/subscriptions" method="post" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input type="email" name="email_address" placeholder="Enter your email" required class="flex-1 px-4 py-3 rounded-lg text-gray-900" />
        <button type="submit" class="btn-secondary">Subscribe</button>
      </form>
    </div>
  </section>
</BaseLayout>
