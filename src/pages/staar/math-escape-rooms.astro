---
import { TPT_STORE_URL } from '../../lib/site-links';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TPT_LISTINGS } from '../../lib/tpt-catalog';
import { PLAY_URL } from '../../lib/site-links';

const SITE = 'https://www.teach4texas.com';
const PAGE_URL = `${SITE}/staar/math-escape-rooms`;

// Only verified-LIVE catalog IDs. Titles/prices match the live TPT pages (checked 2026-10-15).
// Card images are the live TPT cover previews (ecdn.teacherspayteachers.com 750f-<id>-1.jpg).
// liveGame: only where the TPT listing itself says a live game / access code is included.
type Card = { id: string; liveGame?: boolean };
const groups: { name: string; intro: string; cards: Card[] }[] = [
  {
    name: 'Number Vault escape rooms, Grades 3–5',
    intro: 'Self-checking Google Slides escape rooms built on named STAAR math TEKS. About 45–60 minutes each.',
    cards: [{ id: '17460089' }, { id: '17455809' }, { id: '17460004' }],
  },
  {
    name: 'More Grade 3–4 STAAR math practice',
    intro: 'A Grade 3 crack-the-code mystery, a hosted live game show, and task cards for Grades 3 and 4.',
    cards: [{ id: '17538014' }, { id: '17470369', liveGame: true }, { id: '15609299' }, { id: '15609323' }],
  },
  {
    name: 'Other grades',
    intro: 'The same Number Vault format for K–2, Grades 6–7, and Algebra I.',
    cards: [{ id: '17478715' }, { id: '17478343' }, { id: '17477971' }, { id: '17460207' }, { id: '17500215' }, { id: '17467264' }],
  },
];

const byId = new Map(TPT_LISTINGS.map((l) => [l.id, l]));
const resolved = groups.map((g) => ({
  ...g,
  cards: g.cards.map((c) => {
    const l = byId.get(c.id);
    if (!l) throw new Error(`Escape-room card ${c.id} is not in the verified catalog`);
    const imagePath = l.image ?? `/images/escape-rooms/tpt-${c.id}-cover.jpg`;
    const image = `${SITE}${imagePath}`;
    const pinHref =
      'https://www.pinterest.com/pin/create/button/?' +
      new URLSearchParams({ url: PAGE_URL, media: image, description: `${l.title} | STAAR math escape rooms from Teach4 Texas` }).toString();
    return { ...c, listing: l, image, imagePath, pinHref };
  }),
}));
const allCards = resolved.flatMap((g) => g.cards);

const faqs = [
  {
    q: 'What is a STAAR math escape room?',
    a: 'Number Vault is a self-checking Google Slides escape room. Students solve STAAR-style math items, such as word problems, to open each lock. The Grade 3–5 rooms and the Grade 7 Number Vault use single-answer multiple choice (A–D); the Algebra I Equation Vault includes multi-select and multipart items. Every room is built on three or more named TEKS.',
  },
  {
    q: 'Which TEKS does each grade cover?',
    a: 'Grade 3: TEKS 3.4K, 3.5B, 3.4A. Grade 4: TEKS 4.4H, 4.5A, 4.2B. Grade 5: TEKS 5.3E, 5.4B, 5.2A.',
  },
  {
    q: 'Is it Google Slides?',
    a: 'Yes. The Grade 3, 4, and 5 Number Vault rooms are self-checking Google Slides.',
  },
  {
    q: 'How long does one take?',
    a: 'The Grade 3–5 Number Vault rooms take about 45–60 minutes. The Grade 3 Crack the Code mystery takes about 40–50 minutes, and the Grade 3 STAAR Math Game Show about 35–45 minutes.',
  },
  {
    q: 'Can I run it as a live game show?',
    a: 'The STAAR Math Game Show Grade 3 is a hosted live game. Its download includes an access code that you redeem on play.teach4texas.com, then you project the board and students join with a room code. The Number Vault escape rooms are Google Slides, not live games.',
  },
  {
    q: 'Is there a free sample?',
    a: 'No. There is no free escape room sample.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'STAAR Math Escape Rooms, Grades 3–5',
  numberOfItems: allCards.length,
  itemListElement: allCards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.listing.title,
    url: c.listing.href,
    image: c.image,
  })),
};
---

<BaseLayout
  title="STAAR Math Escape Rooms for Grades 3–5 (TEKS)"
  description="Self-checking STAAR math escape rooms for Texas Grades 3–5, each built on named TEKS, plus a Grade 3 crack-the-code mystery, a live game show, task cards, and K–2, 6–7, and Algebra I vaults."
  image="/images/covers/tpt-17455809-cover-28131cab.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#14244B] mb-4">STAAR Math Escape Rooms for Texas Grades 3–5</h1>
    <p class="text-xl text-gray-600 mb-10">
      Escape rooms that practice the STAAR math format, not padlock trivia. Each room names its TEKS, uses STAAR-style word problems and checks answers itself.
    </p>
    <p class="mb-10"><a href={TPT_STORE_URL} target="_blank" rel="noopener" class="btn-primary">Shop the Teach4 Texas TPT store</a></p>

    {resolved.map((g) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-[#14244B] mb-2">{g.name}</h2>
        <p class="text-gray-600 mb-4">{g.intro}</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {g.cards.map((c) => (
            <article class="border border-gray-200 rounded-lg overflow-hidden flex flex-col">
              <a href={c.listing.href} target="_blank" rel="noopener">
                <img src={c.imagePath} alt={`TPT cover preview: ${c.listing.title}`} width="600" height="750" loading="lazy" class="w-full h-auto" />
              </a>
              <div class="p-5 flex flex-col gap-3 flex-1">
                <h3 class="text-lg font-bold text-[#14244B]">{c.listing.title}</h3>
                <p class="text-gray-600 text-base">{c.listing.description}</p>
                <div class="mt-auto flex flex-wrap gap-3 text-base font-semibold">
                  <a href={c.listing.href} target="_blank" rel="noopener" class="text-[#B95321]">{c.listing.price} on TPT &rarr;</a>
                  <a href={c.pinHref} target="_blank" rel="noopener" data-pin-do="buttonPin" class="text-[#B8001C]">Pin It</a>
                  {c.liveGame && (
                    <a href={PLAY_URL} target="_blank" rel="noopener" class="text-[#14244B]">Host the live game</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section id="play-it-live" class="mb-12 rounded-lg bg-[#14244B] text-white p-8">
      <h2 class="text-2xl font-bold mb-3">Play it live</h2>
      <p class="mb-3">
        <a href={PLAY_URL} target="_blank" rel="noopener" class="underline font-semibold">play.teach4texas.com</a> is the host site for live games bought on Teachers Pay Teachers. It is not a free game builder.
      </p>
      <ol class="list-decimal ml-6 space-y-1 mb-3">
        <li>Buy a live-game listing on TPT. Its download includes an access code.</li>
        <li>Redeem the code at <a href="https://play.teach4texas.com/redeem" target="_blank" rel="noopener" class="underline">play.teach4texas.com/redeem</a> to unlock that one game.</li>
        <li>Project the board. Students join at <a href="https://play.teach4texas.com/join" target="_blank" rel="noopener" class="underline">play.teach4texas.com/join</a> with a short room code.</li>
      </ol>
      <p>On this page, the STAAR Math Game Show Grade 3 is the live game.</p>
    </section>

    <section class="mt-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-6">STAAR math escape room FAQ</h2>
      <div class="space-y-6">
        {faqs.map((f) => (
          <div>
            <h3 class="font-bold text-[#14244B]">{f.q}</h3>
            <p class="text-gray-700">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
