---
interface Props {
  href: string;
  title: string;
  description: string;
  price: string;
  originalPrice?: string;
  cta?: string;
  highlight?: boolean;
  image?: string;
}

const { href, title, description, price, originalPrice, cta, highlight = false, image } = Astro.props;
const isFree = price === 'FREE';
const onSale = Boolean(originalPrice && originalPrice !== price);
const priceLabel = cta ?? (isFree ? 'Free download on TPT' : `${price} on TPT`);
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[
    'block rounded-lg p-6 hover:shadow-md transition-shadow',
    highlight ? 'border-2 border-rq-gold bg-white' : 'border border-gray-200',
  ]}
>
  {image && (
    <img src={image} alt={`Product preview: ${title}`} width="800" height="1000" loading="lazy" class="w-full h-auto rounded mb-4" />
  )}
  {isFree && (
    <span class="inline-block bg-rq-gold text-rq-navy text-base font-bold px-2 py-1 rounded mb-2">FREE DOWNLOAD</span>
  )}
  <h3 class="text-lg font-bold text-[#14244B] mb-2">{title}</h3>
  <p class="text-gray-600 text-base mb-3">{description}</p>
  <span class="text-[#B95321] font-semibold text-base">
    {onSale ? (
      <>
        <span class="text-gray-600 line-through mr-2">{originalPrice}</span>
        {price} on TPT &rarr;
      </>
    ) : (
      <>{priceLabel} &rarr;</>
    )}
  </span>
</a>
