---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishDate?: string;
  author?: string;
}

const {
  title,
  description = 'Texas teacher resources for TIA designation, STAAR prep, and classroom tools. Built by Texas educators, for Texas educators.',
  image = '/images/og-default.jpg',
  article = false,
  publishDate,
  author,
} = Astro.props;

// Self-referencing canonical on the served host, without a trailing slash (matches served URLs).
const canonicalPath =
  Astro.url.pathname !== '/' && Astro.url.pathname.endsWith('/')
    ? Astro.url.pathname.slice(0, -1)
    : Astro.url.pathname;
// Keep <title> at 60 chars or under: append the brand suffix only when it fits.
const BRAND_SUFFIX = ' | Teach4Texas';
const fullTitle = title.length + BRAND_SUFFIX.length <= 60 ? `${title}${BRAND_SUFFIX}` : title;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="_9taD9Xrgm4wKNodhRzMcOMNX3FXyKV0mb3jNAsWJu0" />
    <meta name="p:domain_verify" content="f81d6c94f6880b9e18ae05a64959351a"/>

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Teach4Texas" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {article && publishDate && (
      <meta property="article:published_time" content={publishDate} />
    )}
    {article && author && (
      <meta property="article:author" content={author} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-900 font-sans">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
