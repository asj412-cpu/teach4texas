---
import { SCORE_DESK_URL, TPT_STORE_URL, type TptPack } from '../lib/site-links';

interface Props {
  heading?: string;
  intro?: string;
  packs?: TptPack[];
}

const {
  heading = 'Score Desk + printables',
  intro = 'Score Desk is a free local scoring app for STAAR ECR and SCR stacks, plus printable packs. Nothing is uploaded. Not a TEA endorsement.',
  packs = [],
} = Astro.props;
---

<div class="mt-10 p-6 border border-gray-200 rounded-xl bg-white">
  <h2 class="text-xl font-bold text-[#14244B] mb-2">{heading}</h2>
  <p class="text-gray-600 mb-5">{intro}</p>
  <div class="flex flex-col sm:flex-row gap-3">
    <a
      href={SCORE_DESK_URL}
      target="_blank"
      rel="noopener"
      class="btn-primary"
    >
      Open Score Desk
    </a>
    <a
      href={TPT_STORE_URL}
      target="_blank"
      rel="noopener"
      class="btn-secondary"
    >
      Get the printable packs on TPT
    </a>
  </div>
  {packs.length > 0 && (
    <p class="mt-4 text-base text-gray-600">
      Matching packs:{' '}
      {packs.map((pack, index) => (
        <span>
          {index > 0 && <span> · </span>}
          <a href={pack.href} target="_blank" rel="noopener" class="text-[#B95321] font-semibold hover:text-[#9E4519]">
            {pack.label}
          </a>
        </span>
      ))}
    </p>
  )}
</div>
