---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/resources', label: 'Resources' },
  { href: '/about', label: 'About' },
  { href: '/tools', label: 'Score Desk' },
  { href: 'https://play.teach4texas.com/', label: 'Live Game Show' },
];
---

<header class="bg-rq-cream border-b-2 border-rq-gold sticky top-0 z-50">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <picture>
          <source srcset="/images/brand/logo-wordmark.webp" type="image/webp" />
          <img src="/images/brand/logo-wordmark.png" alt="Teach4Texas" width="200" height="48" class="h-12 w-auto" />
        </picture>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-base font-extrabold text-rq-navy hover:text-burnt-500 transition-colors"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#subscribe"
          class="btn-secondary btn-sm"
        >
          Get Updates
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-gray-600 hover:text-navy-700"
        aria-label="Toggle menu"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile Nav -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block py-2 text-base font-extrabold text-rq-navy hover:text-burnt-500"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#subscribe"
        class="mt-2 block btn-secondary btn-sm"
      >
        Get Updates
      </a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
