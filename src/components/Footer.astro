---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy-700 text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <span class="text-xl font-extrabold">Teach<span class="text-burnt-400">4</span>Texas</span>
        <p class="mt-3 text-gray-300 text-sm leading-relaxed">
          Texas teacher resources for TIA designation, STAAR prep, and classroom tools. Built by Texas educators, for Texas educators.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-3">Resources</h3>
        <ul class="space-y-2">
          <li><a href="/blog" class="text-sm text-gray-300 hover:text-white transition-colors">Blog</a></li>
          <li><a href="/resources" class="text-sm text-gray-300 hover:text-white transition-colors">Teacher Resources</a></li>
          <li><a href="/blog/tia-complete-guide" class="text-sm text-gray-300 hover:text-white transition-colors">TIA Guide</a></li>
          <li><a href="/blog/staar-scores-tia-designation" class="text-sm text-gray-300 hover:text-white transition-colors">STAAR & TIA</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div id="subscribe">
        <h3 class="font-semibold text-sm uppercase tracking-wider text-gray-400 mb-3">Stay Updated</h3>
        <p class="text-sm text-gray-300 mb-3">Get TIA tips and STAAR strategies in your inbox.</p>
        <form class="flex gap-2" action="https://app.convertkit.com/forms/9114260/subscriptions" method="post">
          <input
            type="email"
            name="email_address"
            placeholder="your@email.com"
            required
            class="flex-1 px-3 py-2 bg-navy-800 border border-navy-600 rounded-lg text-sm text-white placeholder-gray-400 focus:outline-none focus:border-burnt-400"
          />
          <button
            type="submit"
            class="px-4 py-2 bg-burnt-500 text-white text-sm font-semibold rounded-lg hover:bg-burnt-600 transition-colors"
          >
            Join
          </button>
        </form>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-navy-600 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-400">
      <span>&copy; {currentYear} Teach4Texas. All rights reserved.</span>
      <div class="flex items-center gap-4">
        <a href="https://pinterest.com/teach4texas" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors" aria-label="Pinterest">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
        </a>
        <a href="https://www.teacherspayteachers.com/store/teach4texas" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors text-xs font-semibold">TPT Store</a>
      </div>
    </div>
  </div>
</footer>
