---
import { TPT_STORE_URL } from '../../lib/site-links';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TPT_LISTINGS } from '../../lib/tpt-catalog';
import { PLAY_URL } from '../../lib/site-links';

const SITE = 'https://www.teach4texas.com';
const PAGE_URL = `${SITE}/staar/seasonal-math`;

// Only verified-LIVE catalog IDs (TPT Operator, 2026-10-15). Card images are the
// live TPT cover previews for each listing (downloaded from ecdn.teacherspayteachers.com).
type Card = { id: string; month: string; post?: string; liveGame?: boolean; liveGameLabel?: string };
const months: { name: string; cards: Card[] }[] = [
  { name: 'August', cards: [{ id: '17506345', month: 'August' }, { id: '17516930', month: 'August' }] },
  { name: 'September', cards: [{ id: '17517520', month: 'September' }, { id: '17547396', month: 'September', post: '/blog/grade-3-hispanic-heritage-staar-math-scavenger' }] },
  { name: 'October', cards: [{ id: '17812227', month: 'October', post: '/blog/halloween-grade-4-staar-math-escape-room' }] },
  { name: 'November', cards: [{ id: '17850252', month: 'November', post: '/blog/thanksgiving-grade-4-staar-math-escape-room', liveGame: true }] },
  { name: 'December', cards: [{ id: '18020793', month: 'December', post: '/blog/christmas-grade-4-staar-math-escape-room' }] },
  { name: 'Grade 4 Holiday Bundle: October to December', cards: [{ id: '18041613', month: 'October to December', post: '/blog/grade-4-holiday-staar-math-escape-room-bundle', liveGame: true, liveGameLabel: "Play the Thanksgiving room's live game bonus" }] },
];

const byId = new Map(TPT_LISTINGS.map((l) => [l.id, l]));
const resolved = months.map((m) => ({
  ...m,
  cards: m.cards.map((c) => {
    const l = byId.get(c.id);
    if (!l) throw new Error(`Seasonal card ${c.id} is not in the verified catalog`);
    const imagePath = l.image ?? `/images/seasonal/tpt-${c.id}-cover.jpg`;
    const image = `${SITE}${imagePath}`;
    const pinDescription = `${l.title} | Seasonal STAAR math from Teach4 Texas`;
    const pinHref =
      l.pin ??
      'https://www.pinterest.com/pin/create/button/?' +
      new URLSearchParams({ url: PAGE_URL, media: image, description: pinDescription }).toString();
    return { ...c, listing: l, image, imagePath, pinHref };
  }),
}));
const allCards = resolved.flatMap((m) => m.cards);

const faqs = [
  {
    q: 'Is there Halloween math that still practices STAAR?',
    a: 'Yes. The Halloween Escape Room for Grade 4 practices TEKS 4.4D (multiplication), 4.4E (division), and 4.5A (multi-step problems with strip diagrams and equations).',
  },
  {
    q: 'Which TEKS does the Thanksgiving escape room cover?',
    a: 'The Grade 4 Thanksgiving Escape Room covers TEKS 4.3E, 4.4H, and 4.8C, with 20 STAAR 2.0-style items.',
  },
  {
    q: 'Which TEKS does the Christmas escape room cover?',
    a: 'The Grade 4 Christmas Escape Room covers TEKS 4.3D, 4.5D, and 4.9A, with 20 STAAR 2.0-style items.',
  },
  {
    q: 'Is there a bundle of the Grade 4 holiday escape rooms?',
    a: 'Yes. The Holiday Escape Room Bundle Grade 4 has the Halloween, Thanksgiving, and Christmas escape rooms: 9 Grade 4 TEKS and 60 items in all. It is $11.99 on TPT; bought one at a time the three rooms are $14.97.',
  },
  {
    q: 'Which seasonal STAAR math resources are there for Grade 3?',
    a: 'Three: the Back to School Escape Room (TEKS 3.2A, 3.2C, 3.4A), the Labor Day Math Escape Room (TEKS 3.4K, 3.4G, 3.5A), and the Hispanic Heritage Scavenger Hunt (TEKS 3.4A, 3.4F, 3.5E).',
  },
  {
    q: 'Are these printable or digital?',
    a: 'All seven escape rooms and scavenger hunts are Google Slides plus a printable PDF. The Grade 4 Holiday Bundle packages three of them (Halloween, Thanksgiving, and Christmas) in one listing.',
  },
  {
    q: 'How long does each one take?',
    a: 'The Back to School Escape Room takes about 40–50 minutes. The First Day of School, Labor Day, Hispanic Heritage, Halloween, Thanksgiving, and Christmas resources each take about 45–60 minutes.',
  },
  {
    q: 'Can I run one as a live game show?',
    a: 'The Thanksgiving Escape Room includes a live game bonus on play.teach4texas.com. The access code is in its Start Here PDF, which is also in the Grade 4 Holiday Bundle.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Seasonal STAAR Math Escape Rooms, Grades 3–4',
  numberOfItems: allCards.length,
  itemListElement: allCards.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.listing.title,
    url: c.listing.href,
    image: c.image,
  })),
};
---

<BaseLayout
  title="Seasonal STAAR Math Escape Rooms, Grades 3–4"
  description="Holiday math that still practices STAAR: Back to School, Labor Day, Hispanic Heritage Month, Halloween, Thanksgiving, and Christmas escape rooms and scavenger hunts for Texas Grades 3–4, by TEKS, plus a Grade 4 holiday bundle."
  image="/images/covers/tpt-17850252-cover-a5937c03.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />

  <div class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-[#14244B] mb-4">Holiday Math That Still Practices STAAR</h1>
    <p class="text-xl text-gray-600 mb-10">
      Seasonal escape rooms and scavenger hunts for Texas Grades 3–4, each built on named TEKS. Pick the month, open the TPT listing, or save it to Pinterest for later.
    </p>
    <p class="mb-10"><a href={TPT_STORE_URL} target="_blank" rel="noopener" class="btn-primary">Shop the Teach4 Texas TPT store</a></p>

    {resolved.map((m) => (
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-[#14244B] mb-4">{m.name}</h2>
        <div class="grid sm:grid-cols-2 gap-6">
          {m.cards.map((c) => (
            <article class="border border-gray-200 rounded-lg overflow-hidden flex flex-col">
              <a href={c.listing.href} target="_blank" rel="noopener">
                <img
                  src={c.imagePath}
                  alt={`TPT cover preview: ${c.listing.title}`}
                  width={c.imagePath.includes('preview-') ? '1200' : '600'}
                  height={c.imagePath.includes('preview-') ? '1500' : '750'}
                  loading="lazy"
                  class="w-full h-auto"
                />
              </a>
              <div class="p-5 flex flex-col gap-3 flex-1">
                <h3 class="text-lg font-bold text-[#14244B]">{c.listing.title}</h3>
                <p class="text-gray-600 text-base">{c.listing.description}</p>
                <div class="mt-auto flex flex-wrap gap-3 text-base font-semibold">
                  {c.listing.originalPrice && c.listing.originalPrice !== c.listing.price ? (
                    <a href={c.listing.href} target="_blank" rel="noopener" class="text-[#B95321]"><span class="text-gray-600 line-through mr-2">{c.listing.originalPrice}</span>{c.listing.price} on TPT &rarr;</a>
                  ) : (
                    <a href={c.listing.href} target="_blank" rel="noopener" class="text-[#B95321]">{c.listing.price} on TPT &rarr;</a>
                  )}
                  <a
                    href={c.pinHref}
                    target="_blank"
                    rel="noopener"
                    data-pin-do={c.listing.pin ? undefined : 'buttonPin'}
                    class="text-[#B8001C]"
                  >Pin It</a>
                  {c.liveGame && (
                    <a href={PLAY_URL} target="_blank" rel="noopener" class="text-[#14244B]">{c.liveGameLabel ?? 'Play the live game bonus'}</a>
                  )}
                  {c.post && <a href={c.post} class="text-gray-600 underline">Read the teacher guide</a>}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-16">
      <h2 class="text-2xl font-bold text-[#14244B] mb-6">Seasonal STAAR math FAQ</h2>
      <div class="space-y-6">
        {faqs.map((f) => (
          <div>
            <h3 class="font-bold text-[#14244B]">{f.q}</h3>
            <p class="text-gray-700">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
